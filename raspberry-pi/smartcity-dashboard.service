[Unit]
Description=Smart City dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=admin
WorkingDirectory=/home/admin/smartcity
ExecStart=/usr/bin/python3 /home/admin/smartcity/serial_dashboard.py /dev/ttyUSB0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
